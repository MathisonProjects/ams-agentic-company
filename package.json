{
  "name": "ams-agentic-company",
  "version": "1.0.0",
  "description": "A TypeScript-based application with WebSocket support",
  "main": "dist/index.js",
  "scripts": {
    "build": "cross-env tsc",
    "dev": "cross-env nodemon",
    "start": "cross-env node dist/index.js",
    "watch": "tsc --watch",
    "clean": "rm -rf dist",
    "test": "jest",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:restart": "docker compose restart",
    "docker:logs": "docker compose logs -f",
    "docker:build": "docker compose build",
    "docker:clean": "docker compose down -v --remove-orphans",
    "docker:postgres": "docker exec -it ams-agentic-company-postgres psql -U postgres -d ams_agentic_company",
    "docker:redis": "docker exec -it ams-agentic-company-redis redis-cli",
    "docker:elasticsearch": "curl -X GET 'localhost:9200/_cluster/health?pretty'",
    "docker:kafka": "docker exec -it ams-agentic-company-kafka kafka-topics --bootstrap-server localhost:9092 --list",
    "docker:app-logs": "docker compose logs -f app",
    "docker:app-restart": "docker compose restart app",
    "docker:app-rebuild": "docker compose build app && docker compose up -d app",
    "local:dev": "cross-env NODE_ENV=development nodemon",
    "local:start": "cross-env NODE_ENV=development node dist/index.js",
    "local:build": "cross-env npm run build && npm run local:start"
  },
  "keywords": [
    "typescript",
    "websockets",
    "nodejs"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@elastic/elasticsearch": "^8.10.0",
    "@types/node": "^20.0.0",
    "@types/pg": "^8.10.0",
    "@types/uuid": "^9.0.0",
    "@types/ws": "^8.5.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.0.0",
    "jest": "^29.0.0",
    "nodemon": "^3.0.0",
    "ts-jest": "^29.0.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@types/multer": "^2.0.0",
    "cron": "^3.1.6",
    "cross-env": "^10.0.0",
    "dotenv": "^16.3.0",
    "kafkajs": "^2.2.4",
    "multer": "^2.0.2",
    "node-global-key-listener": "^0.3.0",
    "pg": "^8.11.0",
    "robotjs": "^0.6.0",
    "uuid": "^9.0.0",
    "ws": "^8.14.0"
  }
}
